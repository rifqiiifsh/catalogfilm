# MySQL
# Railway: set DB_HOST/DB_PORT/DB_USER/DB_PASSWORD using references to
# MYSQLHOST/MYSQLPORT/MYSQLUSER/MYSQLPASSWORD from the MySQL service.
# Keep DB_NAME=katalog_film because backend/sql/schema.sql creates this database.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=katalog_film

# Secret minimum 32 karakter acak. Buat sendiri dan jangan bagikan.
JWT_SECRET=
JWT_EXPIRES_IN=7d
PORT=3000
NODE_ENV=development

# Google OAuth 2.0 Web application client ID.
# Gunakan client ID tipe Web application yang sama pada local.properties Android.
GOOGLE_WEB_CLIENT_ID=

# SMTP untuk email reset password.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# URL publik backend yang bisa dibuka penerima email reset password.
# Untuk local testing, http://localhost:3000 hanya bisa dibuka pada perangkat yang sama.
PUBLIC_BASE_URL=http://localhost:3000
